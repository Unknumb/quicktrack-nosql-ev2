{
  "info": {
    "name": "QuickTrack API - EV2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "EP2 BDY0101 – QuickTrack (Forma B). Integrantes: Alvaro Uribe, Nicolas Mansilla y Genesis Montero."
